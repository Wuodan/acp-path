{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACP path mapping rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "payload", "selectors"],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "string",
            "enum": ["params", "result"]
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
