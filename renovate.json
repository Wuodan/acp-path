{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "separateMajorMinor": false,
  "enabledManagers": ["gomod", "github-actions", "custom.regex"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/.*\\/.*\\.ya?ml$/"],
      "matchStrings": [
        "[A-Za-z][A-Za-z0-9_ -]*:[ \\t]*[\"']?(?<currentValue>[^\\s\"']+)[\"']?[ \\t]*# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?"
      ],
      "versioningTemplate": "{{{versioning}}}"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go modules",
      "minimumReleaseAge": "3 days",
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "workflow version pins",
      "minimumReleaseAge": "3 days"
    }
  ]
}
